{UTF-8}
repair rate=
	IF THEN ELSE(Time >= 28 ,SMOOTH3I(0.01, 105 , 0.24 ) , average repair rate)
	~	
	~	from 0.23 to 0.07 during intensive repair
	|

minor failure rate=
	(1/18)*PM impact 1
	~	
	~	0.04 until 0.23 in Baker
	|

fossil depletion=
	Discarded Ventilators/1000*21.93
	~	
	~		|

climate change=
	Discarded Ventilators/1000*125.15
	~	
	~	per ton
	|

CM cost=
	minor failure*641.6
	~	
	~		|

PM impact 1=
	IF THEN ELSE(PM rate<=1/12, 1 , 0.95 )
	~	
	~		|

discard cost=
	discarded*ventilator weight*1
	~	
	~	1$/kg
	|

lifespan=
	180*PM impact 2
	~	
	~	13 anos = 156 meses; 15 anos= 180 meses
	|

repair cost=
	repaired*641.6
	~	
	~	$1570/ventilator
	|

discarded flow=
	discarded
	~	
	~		|

Discarded Ventilators= INTEG (
	discarded flow*ventilator weight,
		0)
	~	
	~		|

marine eutrophication=
	Discarded Ventilators/1000*7.68*10^2
	~	
	~		|

Total Cost= INTEG (
	CM cost+discard cost+PM cost+repair cost,
		0)
	~	
	~		|

freshwater ecotoxicity=
	Discarded Ventilators/1000*8.67*10^2
	~	
	~		|

freshwater eutrophication=
	Discarded Ventilators/1000*5.49*10^3
	~	
	~		|

human toxicity=
	Discarded Ventilators/1000*4.15
	~	
	~		|

PM impact 2=
	IF THEN ELSE(PM rate<=1/12, 1 , 1.05 )
	~	
	~		|

major failure rate=
	MAX(0, RANDOM NORMAL(-0.0022,0.0025,0.0002,0.0008,777) )*PM impact 1
	~	
	~		|

ventilator weight=
	20
	~	
	~	range from 15 to 30 kg
	|

marine ecotoxicity=
	Discarded Ventilators/1000*8.9*10^2
	~	
	~		|

PM cost=
	sent to PM*266.4
	~	
	~		|

average repair rate=
	0.0006
	~	
	~		|

repaired=
	Idle ventilators*repair rate
	~	
	~		|

discard rate=
	1/lifespan
	~	
	~		|

discarded=
	Idle ventilators*discard rate
	~	
	~		|

returned from PM=
	sent to PM
	~	
	~		|

Idle ventilators= INTEG (
	major failure-discarded-repaired,
		3338)
	~	
	~		|

major failure=
	Ventilators in use*major failure rate
	~	
	~		|

minor failure=
	Ventilators in use*minor failure rate
	~	
	~		|

PM rate=
	1/6
	~	
	~		|

sent to PM=
	Ventilators in use*PM rate
	~	
	~		|

Repaired Ventilators= INTEG (
	repaired-returned from repair,
		0)
	~	
	~		|

return from repair rate=
	1-(0.27*0.5)
	~	
	~	instead 0f 27% of idle ventilators aking over 1 month to return to use \
		here we make a 50% decrease meaning only 13,5% of idle ventilators would \
		take over a motn to be repaired
	|

returned from CM=
	minor failure
	~	
	~		|

"Ventilators in Preventive Maintenance (PM)"= INTEG (
	sent to PM-returned from PM,
		0)
	~	
	~		|

returned from repair=
	Repaired Ventilators*return from repair rate
	~	
	~		|

"Ventilators in Corrective Maintenance (CM)"= INTEG (
	minor failure-returned from CM,
		0)
	~	
	~		|

Ventilators in use= INTEG (
	distribution+returned from PM+returned from CM+returned from repair-sent to PM-minor failure\
		-major failure,
		57671)
	~	ventilators
	~		|

data distribution:INTERPOLATE:
	~	ventilators
	~		|

distribution=
	IF THEN ELSE(Time<=74, data distribution, RANDOM NORMAL(0, 560, 280, 500, 0))
	~	ventilators/Month
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 133
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME  = 1
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Month [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Month [0,?]
	~	The time step for the simulation.
	|

